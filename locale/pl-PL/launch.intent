# Launching / focusing a desktop application.
# The {application} slot is open-vocabulary; the loader drops any value listed
# in application.blacklist so the generic "open ..." phrasings do not hijack
# utterances that belong to other skills (see application.blacklist).
włącz aplikację {application}
Otwórz {application}
uruchomić {application}
uruchom aplikację {application}
otwórz program {application}
otwórz aplikację {application}
uruchomić aplikację {application}
możesz uruchomić aplikację {application}
czy możesz otworzyć aplikację {application}
możesz włączyć program {application}
mógłbyś uruchomić aplikację {application}
chcę uruchomić aplikację {application}
muszę uruchomić program {application}
chcę otworzyć aplikację {application}
muszę otworzyć program {application}
odpal aplikację {application}
przywołaj okno aplikacji {application}
uruchom program {application}
